<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <application android:label="J2Droid" android:icon="@mipmap/ic_j2droid" android:roundIcon="@mipmap/ic_j2droid" android:theme="@android:style/Theme.Material.NoActionBar" android:largeHeap="true" android:allowBackup="false">
        <activity android:name="j2a.offline.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" /></provider>
        <service android:name="j2a.offline.BuildService" android:foregroundServiceType="dataSync" android:exported="false" />
    </application>
</manifest>